# Copy to .env and edit. Never commit .env.
#
# NOTE: Open WebUI stores most settings in its database after the first start.
# Changing a value here later may have no effect. Change it in Admin Settings, or
# reset the open-webui volume.

# --- Required -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me
# Admin account used by the bootstrap and eval scripts. If no user exists yet,
# bootstrap creates this account as the first admin.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me

# --- Access -------------------------------------------------------------------
# 127.0.0.1 = local only. Use 0.0.0.0 only behind a TLS reverse proxy (hosted demo).
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000
ENABLE_SIGNUP=true
# New accounts wait for admin approval.
DEFAULT_USER_ROLE=pending
# Uploads let users send learner data to the server. Keep false unless needed.
ALLOW_FILE_UPLOADS=false

# --- Chat model ---------------------------------------------------------------
# Option A (default): local model via Ollama.
#   GPU (>=12 GB VRAM): gemma3:12b   |   CPU / small GPU: gemma3:4b (weaker in FI)
BASE_MODEL=gemma3:12b
# Models pulled by the ollama-pull service (chat model + embedding model).
OLLAMA_PULL_MODELS="gemma3:12b bge-m3"
# Ollama's default context (2048) truncates the system prompt plus retrieved
# sources. Keep this at 8192 or more.
NUM_CTX=8192
LLM_TEMPERATURE=0.3
#
# Option B: bring your own key, or your own vLLM server (OpenAI-compatible).
# Set ENABLE_OPENAI_API=true and set BASE_MODEL to the provider's model id.
# Ollama still runs for the embeddings, so set OLLAMA_PULL_MODELS=bge-m3.
ENABLE_OPENAI_API=false
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# --- Retrieval ----------------------------------------------------------------
# Multilingual embeddings (EN/ES/DE/FI/NL and others).
EMBEDDING_MODEL=bge-m3
# chroma (built in, default) | qdrant (--profile qdrant) | pgvector (--profile pgvector)
VECTOR_DB=chroma
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RAG_TOP_K=6

# --- Coach preset -------------------------------------------------------------
NEXR_MODEL_ID=nexr-coach
NEXR_MODEL_NAME=NEXR HCD Coach

# --- Image versions (bootstrap.py targets the Open WebUI v0.6 API) ------------
# After bumping a version, re-run the eval set.
OPEN_WEBUI_TAG=v0.6.18
OLLAMA_TAG=0.9.6
